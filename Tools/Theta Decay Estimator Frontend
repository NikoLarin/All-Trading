import streamlit as st
import pandas as pd
import math
import matplotlib.pyplot as plt
import numpy as np

st.title("Tester")

extrinsic_value = float(st.text_input("Extrinsic Value", value="0"))
dte = st.slider("Days to expiry", min_value=1, max_value=365)

time_passed = st.slider('Time Passed', max_value=dte)

# Calculate decay values for all time points
time_range = np.linspace(0, time_passed, 100)
theta_decay = np.sqrt((dte - time_range) / dte) * extrinsic_value
final_value = round(theta_decay[-1],2)

fig, ax = plt.subplots()
ax.plot(time_range, theta_decay,color='red')
ax.set_xlabel("Days Passed")
ax.set_ylabel("Extrinsic Value")
ax.set_title("Theta Decay Θ")
ax.grid(True, alpha=0.3)
st.pyplot(fig)

st.text(f'The estimated extrinsic value is {final_value}')
